# ---- Database ----
# PostgreSQL connection string (Neon, Supabase, or local Postgres)
DATABASE_URL=

# ---- Auth ----
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Server ----
PORT=5000
NODE_ENV=development
# URL of the deployed/running client, for CORS + cookie settings
CLIENT_URL=http://localhost:5173

# ---- Client (Vite — must be prefixed VITE_) ----
VITE_API_URL=http://localhost:5000/api
VITE_WHATSAPP_NUMBER=
VITE_GOOGLE_MAPS_URL=
